title: "Neuron Choice and Initialization Stability in SNNs"
authors:
  - family-names: "Dikmen"
    given-names: "İsmail Can"
  - family-names: "Karadağ"
    given-names: "Teoman"
version: 0.2.0
date-released: 2026-11-16
url: "https://github.com/DrCanD/snn-neuron-choice-and-stability"
